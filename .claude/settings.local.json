{
  "permissions": {
    "allow": [
      "Read(/**)",
      "Edit(/**)",
      "WebSearch",
      "WebFetch(domain:opencode.ai)",
      "WebFetch(domain:opencode.ai)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:packagist.org)",
      "WebFetch(domain:hub.docker.com)",
      "Bash(*)",
      "Bash(curl *)",
      "Bash(sed *)",
      "Bash(trash *)",
      "Bash(trash-put *)",
      "Bash(gtrash *)",
      "Monitor",
      "TaskCreate",
      "TaskUpdate",
      "TaskStop",
      "TaskList",
      "TaskGet",
      "ToolSearch",
      "Skill(CHECK)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm)",
      "Bash(unlink *)",
      "Bash(dd *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(*nsenter*)",
      "Bash(*docker.sock*)"
    ],
    "defaultMode": "default"
  }
}
